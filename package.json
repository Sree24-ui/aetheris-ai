{
  "name": "ai-teacher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate": "node --env-file=.env.local db/migrate.mjs",
    "test": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test \"src/**/*.test.ts\" \"db/**/*.test.mjs\"",
    "test:watch": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test --watch \"src/**/*.test.ts\" \"db/**/*.test.mjs\"",
    "check": "npm run lint && tsc --noEmit && npm test"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.3",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.14",
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
    "mammoth": "^1.12.2",
    "mermaid": "^11.17.2",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "prismjs": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "xml2js": "^0.6.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.6.0",
    "npm": ">=10"
  }
}
