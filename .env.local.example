# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_FALLBACK_MODELS=z-ai/glm-5.2:free,google/gemma-4-31b-it:free,openrouter/free

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-base64-secret

# Google OAuth client (console.cloud.google.com -> APIs & Services -> Credentials).
# Authorized redirect URI: <your-app-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Database (Postgres, used by Auth.js's user/session storage) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
