# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_FALLBACK_MODELS=z-ai/glm-5.2:free,google/gemma-4-31b-it:free,openrouter/free
# Optional: override the API endpoint (e.g. a proxy) and the per-model timeout
# in milliseconds before failing over to the next model in the chain.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_TIMEOUT_MS=22000

# --- Public site URL ---
# Used for metadata/OpenGraph and OpenRouter app attribution. Falls back to
# Vercel's own production URL, then http://localhost:3000 in development.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-base64-secret

# Google OAuth client (console.cloud.google.com -> APIs & Services -> Credentials).
# Authorized redirect URI: <your-app-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Database (Postgres, used by Auth.js's user/session storage) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
