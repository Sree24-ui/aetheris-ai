# --- LLM (Google Gen AI / Gemini) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides:
# GEMINI_MODEL: defaults to gemini-3.6-flash.
# GEMINI_BASE_URL: point at a proxy or a different API version.
# GEMINI_TIMEOUT_MS: per-request timeout before retrying (default 30000).
# GEMINI_MAX_ATTEMPTS: total tries per call, covering 429/5xx (default 3).
# GEMINI_THINKING_BUDGET: 2.5 models bill internal reasoning against the
#   output limit, which can starve small-budget calls. 0 (the default here)
#   disables thinking; -1 lets the model decide; a positive number caps it.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_MS=30000
# GEMINI_MAX_ATTEMPTS=3
# GEMINI_THINKING_BUDGET=0

# --- Public site URL ---
# Used for metadata/OpenGraph. Falls back to Vercel's own production URL,
# then http://localhost:3000 in development.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-base64-secret

# AUTH_TRUST_HOST: required when self-hosting behind a reverse proxy, or
# Auth.js rejects the request with UntrustedHost. Vercel is detected
# automatically and does not need this. Only set it where the proxy in front
# of the app terminates TLS and sets X-Forwarded-Host itself — with it set, a
# forged Host header would otherwise be believed.
# AUTH_TRUST_HOST=true

# Google OAuth client (console.cloud.google.com -> APIs & Services -> Credentials).
# Authorized redirect URI: <your-app-url>/api/auth/callback/google
# OPTIONAL — leave both unset and the Google provider is not registered at
# all, so the sign-in and sign-up pages hide the "Continue with Google"
# button rather than offering one that errors. Email + password still work.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Database (Postgres, used by Auth.js's user/session storage) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# TLS. A remote database connection verifies the server's certificate; a
# localhost connection uses no TLS at all. Neither needs configuration on a
# managed provider whose certificate chains to a public CA (Neon, Supabase,
# RDS with the public bundle).
#
# DATABASE_CA_CERT: PEM bundle for a provider that uses a private CA. Paste
#   the certificate itself, newlines and all.
# DATABASE_SSL_INSECURE: set to "true" to skip certificate verification. This
#   is refused outright when NODE_ENV=production — it is a local-development
#   escape hatch for a self-signed test database, never a deployment setting.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DATABASE_SSL_INSECURE=false

# Connection pool bounds. Lower DATABASE_POOL_MAX when several instances share
# one database's connection allowance.
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Model provider ------------------------------------------------------
# Which backend answers lessons: "groq" (default) or "gemini".
#   groq    ~1000 requests + 8k tokens/minute, ~3s responses. Best default —
#           Gemini's free tier allows only 20 requests/day, which one lesson
#           exhausts. Note: observed leaking CJK characters into Tamil output.
#   gemini  stronger on low-resource languages (Tamil, Telugu, Malayalam).
LLM_PROVIDER=groq

# GROQ_API_KEY: create at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Shared across providers (fall back to the GEMINI_* names when unset):
# LLM_TIMEOUT_MS=30000
# LLM_MAX_ATTEMPTS=3

# --- Tunables: CLIENT (must keep the NEXT_PUBLIC_ prefix) -----------------
# Next.js inlines process.env at build time and substitutes `undefined` for any
# non-NEXT_PUBLIC_ var in the browser bundle. These are read by client
# components, so without the prefix they silently do nothing.
# NEXT_PUBLIC_MIN_PASSWORD_LENGTH=8
# NEXT_PUBLIC_TRANSLATE_CONCURRENCY=3
# NEXT_PUBLIC_MOUTH_FLAP_MS=130
# NEXT_PUBLIC_BLINK_DURATION_MS=140
# NEXT_PUBLIC_CONFETTI_DURATION_MS=5000
# NEXT_PUBLIC_SPEECH_MS_PER_CHAR=90
# NEXT_PUBLIC_SPEECH_WATCHDOG_MIN_MS=4000
# NEXT_PUBLIC_SPEECH_WATCHDOG_MAX_MS=60000
# NEXT_PUBLIC_SPEECH_RESUME_WATCHDOG_MS=20000

# --- Tunables: SERVER ----------------------------------------------------
# Per-call output budgets. Lower these to fit a tighter tokens-per-minute cap.
# TOKENS_LESSON_PLAN=8192
# TOKENS_QUIZ=4096
# TOKENS_TRANSLATION=2048
# TOKENS_LEARNING_PATH=2048
# TOKENS_EVALUATION=1536
# TOKENS_CHAT=1024
# TOKENS_REPORT=1024
# TOKENS_INSTRUCTION=512
# TOKENS_CONCEPTS=300
# MODEL_TEMPERATURE=0.7

# Request behaviour and backoff.
# LLM_TIMEOUT_MS: one attempt's timeout (1-120000).
# LLM_TOTAL_DEADLINE_MS: budget for the whole operation — every attempt,
#   backoff and output-repair round together. Keep it below the route's
#   maxDuration (60s) so a response can still be serialised.
# LLM_MAX_REPAIR_ATTEMPTS: how many times the model may be asked to correct
#   structurally invalid JSON before the request fails (0-3).
# LLM_TIMEOUT_MS=30000
# LLM_MAX_ATTEMPTS=3
# LLM_TOTAL_DEADLINE_MS=50000
# LLM_MAX_REPAIR_ATTEMPTS=1
# LLM_RETRY_BASE_DELAY_MS=1000
# LLM_RATE_LIMIT_FALLBACK_MS=5000
# LLM_SERVER_ERROR_FALLBACK_MS=2000

# Every numeric value above is range- and integer-checked at startup: an
# out-of-range or non-integer value falls back to the default shown rather
# than being used. CHUNK_OVERLAP must be smaller than CHUNK_MAX_CHARS, or it
# falls back to a sixth of the chunk size (an overlap at or above the chunk
# size makes the chunk loop stop advancing).

# Retrieval, chunking and ingestion.
# RETRIEVAL_TOP_K=10
# CHUNK_MAX_CHARS=900
# CHUNK_OVERLAP=150
# CHUNK_MIN_CHARS=20
# EMBED_BATCH_SIZE=16
# MIN_EXTRACTED_CHARS=20
# DOCUMENT_PREVIEW_CHARS=400
# CONCEPT_SAMPLE_CHUNKS=5
# CONCEPT_SAMPLE_CHARS=4000
# MAX_CONCEPT_TAGS=6

# Retention. Used by `npm run retention`, which is a manual/scheduled sweep —
# nothing deletes uploads automatically.
# DOCUMENT_RETENTION_DAYS=90

# Conversation and history.
# CHAT_HISTORY_TURNS=6
# MAX_FOLLOW_UPS=2
# HISTORY_PAGE_SIZE=50
